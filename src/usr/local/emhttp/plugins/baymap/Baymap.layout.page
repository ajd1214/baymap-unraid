<?php endif; ?>

<script>
const bmlCsrf = <?=json_encode($csrf)?>;
const bmlInit = <?=json_encode($L['groups'])?>;
function bmlAdd(g){
  const tr=document.createElement('tr'); tr.dataset.id=g.id||'';
  tr.innerHTML=`<td><input type="text" data-f="name"></td><td><input class="n" type="number" min="1" max="24" data-f="cols"></td>
   <td><input class="n" type="number" min="1" max="24" data-f="rows"></td><td><input class="n" type="number" min="0" data-f="start"></td>
   <td><select data-f="order"><option value="row">along rows</option><option value="column">down columns</option></select></td>
   <td><select data-f="corner"><option value="tl">top left</option><option value="tr">top right</option><option value="bl">bottom left</option><option value="br">bottom right</option></select></td>
   <td><select data-f="orient"><option value="h">horizontal</option><option value="v">vertical (upright)</option></select></td>
   <td><select data-f="place"><option value="below">below previous</option><option value="beside">beside previous</option></select></td>
   <td><input type="text" data-f="blank" placeholder="e.g. 3, 7-8" style="width:90px"></td>
   <td><input type="color" data-f="color"></td><td><input type="button" value="Delete" onclick="if(confirm('Delete this group? Disks placed in it become unplaced.'))this.closest('tr').remove()"></td>`;
  const v={name:g.name||'New group',cols:g.cols||4,rows:g.rows||1,start:g.start??1,order:g.order||'row',corner:g.corner||'tl',
    orient:g.orient||'h',place:g.place||'below',blank:(g.blank||[]).join(', '),color:g.color||'#888888'};
  for (const k in v) tr.querySelector('[data-f="'+k+'"]').value=v[k];
  document.querySelector('#bm-groups tbody').appendChild(tr);
}
bmlInit.forEach(bmlAdd);
async function bmlPost(data, box){
  const f=new URLSearchParams(); f.append('csrf_token', bmlCsrf); for (const k in data) f.append(k, data[k]);
  const msg=box.querySelector('.bm-msg'); msg.textContent='working...';
  try { const r=await fetch('/plugins/baymap/include/action.php',{method:'POST',body:f}); const j=await r.json(); msg.textContent=j.msg; return j; }
  catch(e){ msg.textContent='failed: '+e; return {ok:false}; }
}
function bmlSave(){
  const groups=[...document.querySelectorAll('#bm-groups tbody tr')].map(tr=>{ const g={id:tr.dataset.id};
    tr.querySelectorAll('[data-f]').forEach(e=>g[e.dataset.f]=e.value); return g; });
  bmlPost({action:'save_groups',groups:JSON.stringify(groups)}, document.getElementById('bm-box'));
}
async function bmlImport(){
  if (!confirm('Replace Baymap\'s groups and tray placements with the Disk Location layout?')) return;
  const j=await bmlPost({action:'import_dl'}, document.getElementById('bm-imp')); if (j.ok) setTimeout(()=>location.reload(),900);
}
</script>
