<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "baymap">
<!ENTITY author    "ajd1214">
<!ENTITY version   "2026.11.10">
<!ENTITY launch    "Utilities/Baymap">
<!ENTITY gitURL    "https://raw.githubusercontent.com/ajd1214/baymap-unraid/main">
<!ENTITY pluginURL "&gitURL;/baymap.plg">
<!ENTITY plgPATH   "/boot/config/plugins/&name;">
<!ENTITY emhttp    "/usr/local/emhttp/plugins/&name;">
<!ENTITY pkgSHA    "fe8841525811663564b5895d1a05d1a93039be46a26cfc6996413a4a0c6e0c7f">
]>
<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        icon="hdd-o"
        min="7.0.0">

<CHANGES>
###2026.11.10
- Rated SSD life (wear counters) no longer counts as a fault: only real errors raise a disk's health level. Life used is still shown in the disk's details

###2026.10.24c
- Fix: Save buttons could hang; requests are now sent form-encoded like the rest of the Unraid web UI

###2026.10.24b
- Fix: Layout tab buttons did nothing (its script clashed with the Map tab script on the same page)

###2026.10.24a
- Layout per group: start corner (top/bottom, left/right), horizontal or upright trays, place beside or below the previous group, blank trays

###2026.10.24
- First release: bay map, Dashboard tile, health at a glance from Unraid's own SMART reports (never wakes a disk),
  disk records, on-demand Locate and Benchmark, import from Disk Location
</CHANGES>

<FILE Name="&plgPATH;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&gitURL;/packages/&name;-&version;.txz</URL>
<SHA256>&pkgSHA;</SHA256>
</FILE>

<!-- install / every boot -->
<FILE Run="/bin/bash">
<INLINE>
P=&plgPATH;
mkdir -p "$P"
# First install: take over the Disk Location layout if it is still on the flash drive.
if [ ! -f "$P/layout.json" ] &amp;&amp; [ -f /boot/config/plugins/disklocation/locations.json ]; then
  php -r 'require "&emhttp;/include/lib.php"; [$ok,$m]=bm_import_disklocation(); echo "Disk Location import: $m\n";'
fi
for f in "$P"/&name;-*.txz; do [ "$f" = "$P/&name;-&version;.txz" ] || rm -f "$f"; done
echo "Baymap &version; installed. Utilities > Baymap"
</INLINE>
</FILE>

<!-- uninstall: remove the package, keep layout.json and records.json on the flash drive -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &plgPATH;/&name;-&version;.txz >/dev/null 2>&amp;1
rm -rf &emhttp;
rm -f &plgPATH;/&name;-*.txz
echo "Baymap removed. Layout and disk records were kept in &plgPATH;"
</INLINE>
</FILE>
</PLUGIN>
